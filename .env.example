# The consumer database's `parcels` schema (pdo-db on Fly.io in production),
# which data-orchestrator's `etl` job fills. Read-only: use the
# `consumer_reader` role (all-in-one/scripts/consumer-db.mjs). Needs
# data-orchestrator migration 0016 (`parcels.stored_images`) or later.
PARCELS_DB_URL=postgres://consumer_reader:CHANGE_ME@pdo-db.fly.dev:5432/carolinataxsale?sslmode=verify-full

# The image store (Cloudflare R2 bucket `pdo-images`, over the S3 API) that
# `parcels.stored_images` points into. This app only reads from it, so give it
# a read-only token scoped to the bucket.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=pdo-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Consumer auth store (pdo-db, `consumer_auth` schema), over the dedicated
# `cts_ui_app` role. See scripts/provision-auth-db.mjs.
AUTH_DB_URL=postgres://cts_ui_app:CHANGE_ME@pdo-db.fly.dev:5432/carolinataxsale?sslmode=verify-full

# Brevo API key for sending OTP emails from noreply@carolinataxsale.com.
# Unset in dev - lib/email.ts logs the code to the server console instead.
BREVO_API_KEY=
