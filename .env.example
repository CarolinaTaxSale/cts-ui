# Same-origin proxy target for read-only parcel data (see
# app/api/orchestrator/[...path]/route.ts). Points at the data-orchestrator
# API - the source of truth for parcel/county data.
ORCHESTRATOR_URL=http://localhost:3100

# Consumer auth store (pdo-db on Fly.io, `consumer_auth` schema) - a
# dedicated least-privilege role, NOT the orchestrator's etl_writer/
# consumer_reader roles. See scripts/provision-auth-db.mjs.
AUTH_DB_URL=postgres://cts_ui_app:CHANGE_ME@pdo-db.fly.dev:5432/carolinataxsale?sslmode=verify-full

# HMAC secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# Brevo API key for sending OTP emails from noreply@carolinataxsale.com.
# Left unset in dev - lib/email.ts logs the code to the server console instead
# of sending a real email until this is wired up.
BREVO_API_KEY=
