# The consumer database (pdo-db on Fly.io, `parcels` schema) that
# data-orchestrator's `etl` job replicates into - this app reads parcel/tax
# data straight from here (see lib/parcels-db.ts), not through the
# orchestrator: in production there is no orchestrator to call, it's purely a
# local data-collection tool. Use the read-only `consumer_reader` role that
# all-in-one/scripts/consumer-db.mjs already provisions - never etl_writer.
PARCELS_DB_URL=postgres://consumer_reader:CHANGE_ME@pdo-db.fly.dev:5432/carolinataxsale?sslmode=verify-full

# Same-origin image proxy target (see app/api/orchestrator/[...path]/route.ts)
# for satellite/street-view images only - that pipeline hasn't been ported to
# read straight from storage yet, so it still calls the orchestrator directly.
# Only needed against a locally running all-in-one stack.
ORCHESTRATOR_URL=http://localhost:3100

# Consumer auth store (pdo-db on Fly.io, `consumer_auth` schema) - a
# dedicated least-privilege role, NOT the orchestrator's etl_writer/
# consumer_reader roles. See scripts/provision-auth-db.mjs.
AUTH_DB_URL=postgres://cts_ui_app:CHANGE_ME@pdo-db.fly.dev:5432/carolinataxsale?sslmode=verify-full

# HMAC secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# Brevo API key for sending OTP emails from noreply@carolinataxsale.com.
# Left unset in dev - lib/email.ts logs the code to the server console instead
# of sending a real email until this is wired up.
BREVO_API_KEY=
